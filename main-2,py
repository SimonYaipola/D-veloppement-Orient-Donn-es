@app.get("/creerChambre")
def read_item(chambre: ChambreDTO):
    try:
        return creerChambre(chambre)
    except ValueError as e:
        return HTTPException(status_code=404, detail=str(e))

uvicorn.run (app, host="172.0.0.1", port=8000)